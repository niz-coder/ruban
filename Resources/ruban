#!/bin/sh
# Pilote Ruban depuis le terminal, Raccourcis ou Raycast.
#   ruban focus-right | move-left | cycle-width | full-width | centre | toggle | settings …
if [ -z "$1" ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  cat <<'EOF'
usage: ruban <action>

  focus-left focus-right focus-up focus-down focus-first focus-last jump-1 … jump-9
  move-left move-right move-up move-down send-to-next-display
  cycle-width full-width centre wider narrower taller shorter equalize-heights
  pin-left pin-right stack-left stack-right pop-left pop-right toggle-tabbed toggle-float
  toggle start stop settings
EOF
  exit 0
fi
exec open -g "ruban://$1"
